  enter: 0
  s: 0
  talkText:
  - textLine1: Wanted to enter the Goblin's Lair you say?
    textLine2: 
    textLine3: 
    textLine4: 
  - textLine1: Well, all you need to do is ridding of the one
    textLine2: who casted a protection ward spell on its
    textLine3: entrance.
    textLine4: 
  - textLine1: I know who did that but it's dangerous.
    textLine2: If you insist though, prove your worth
    textLine3: by killing ten Giant Spiders.
    textLine4: 
  ongoingQuestText:
  - textLine1: Prove your worth killing 10 Giant Spiders.
    textLine2: 
    textLine3: 
    textLine4: 
  finishQuestText:
  - textLine1: You're much more skilled than I expected.
    textLine2: Very well, I guess you're ready to face
    textLine3: the Goblin Warlock.
    textLine4: 
  - textLine1: +500 Cash , +200EXP
    textLine2: 
    textLine3: 
    textLine4: 
  alreadyFinishText:
  - textLine1: Thank You
    textLine2: 
    textLine3: 
    textLine4: 
