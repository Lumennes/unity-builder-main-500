  enter: 0
  s: 0
  talkText:
  - textLine1: The Goblin Warlock is hiding in the deepest
    textLine2: part of the Goblinhaunt Woods to the west.
    textLine3: 
    textLine4: 
  - textLine1: Watch your back, that thing is a very
    textLine2: formidable foe.
    textLine3: 
    textLine4: 
  - textLine1: If you can defeat him, I can probably
    textLine2: break the warding spell.
    textLine3: 
    textLine4: 
  ongoingQuestText:
  - textLine1: 'If you can defeat Goblin Warlock, '
    textLine2: I can probably break the warding spell.
    textLine3: 
    textLine4: 
  finishQuestText:
  - textLine1: Hey, thanks a lot for killing that Goblin Warlock!
    textLine2: As promised, I'll unseal the ward for you...
    textLine3: 
    textLine4: 
  - textLine1: +1000 Cash , +500EXP
    textLine2: 
    textLine3: 
    textLine4: 
  alreadyFinishText:
  - textLine1: Good Luck!!
    textLine2: 
    textLine3: 
    textLine4: 
